<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory android:title="Transliteration setting">
        <ListPreference android:entries="@array/pref_translit_schemes" android:title="Transliteration scheme" android:key="@string/pref_translit_scheme" android:summary="Choose a transliteration scheme" android:entryValues="@array/pref_translit_values" />
        <net.ultramagic.hiero.util.HelpPreference android:title="@string/help_pref_translit_scheme" android:key="@string/help_pref_translit_key" />
    </PreferenceCategory>
    <PreferenceCategory android:title="Display options">
        <CheckBoxPreference android:title="Display Gardiner codes 'Aa' as 'J'" android:key="@string/pref_category_j" android:summaryOn="Show as 'J'" android:summaryOff="Show as 'Aa'" />
        <CheckBoxPreference android:title="Display Gardiner codes" android:key="@string/pref_show_mdc" android:summaryOn="Show codes" android:summaryOff="Don't show codes" />
        <CheckBoxPreference android:title="@string/mirror_glyphs" android:key="@string/pref_show_rtl" android:summaryOn="@string/mirror_glyphs_on" android:summaryOff="@string/mirror_glyphs_off" />
    </PreferenceCategory>
</PreferenceScreen>
